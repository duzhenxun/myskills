  "body": {
    "storage": {
      "value": "<p><span style=\"color: rgb(0,0,0);\">Hi all，</span><br /><span style=\"color: rgb(0,0,0);\">【六一】活动将于5.27日进入测试阶段，现申请相关资源及礼物配置。</span><br /><span style=\"color: rgb(0,0,0);\">辛苦@叶导 审批，&nbsp;</span><br /><span style=\"color: rgb(0,0,0);\">辛苦@灿灿配置并返回相关id。<br /></span></p><p><br /></p><p><span style=\"color: rgb(0,0,0);\">具体需求如下：</span><br /><span style=\"color: rgb(0,0,0);\">1、 礼物配置：</span></p><table class=\"relative-table\" style=\"width: 26.012%;\"><colgroup class=\"\"><col class=\"\" style=\"width: 31.2634%;\" /> <col class=\"\" style=\"width: 25.5706%;\" /> <col class=\"\" style=\"width: 12.6803%;\" /> <col class=\"\" style=\"width: 6.996%;\" /> <col class=\"\" style=\"width: 8.08913%;\" /> <col class=\"\" style=\"width: 15.3038%;\" /> </colgroup><tbody class=\"\"><tr class=\"\"><td rowspan=\"10\">礼物墙礼物</td><td>礼物名称</td><td>价格</td><td>id</td><td>url</td><td>备注</td></tr><tr class=\"\"><td>童年放映机</td><td>6</td><td><br /></td><td><br /></td><td>新，幸</td></tr><tr class=\"\"><td>等你下课</td><td>10</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>青空猫耳酱</td><td>99</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>甜漾秋千</td><td>520</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>夏日稚趣</td><td>1314</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>心跳时区</td><td>5200</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>荆棘诗篇</td><td>13140</td><td><br /></td><td><br /></td><td>高光</td></tr><tr class=\"\"><td>挚爱牵手</td><td>52000</td><td><br /></td><td><br /></td><td>高光</td></tr><tr class=\"\"><td>山海棋局</td><td>99999</td><td><br /></td><td><br /></td><td>高光</td></tr></tbody></table><p><span style=\"color: rgb(0,0,0);\">2、&nbsp;资源配置：</span></p><table><colgroup class=\"\"><col class=\"\" style=\"width: 80.9pt;\" /> <col class=\"\" style=\"width: 171.9pt;\" /> <col class=\"\" style=\"width: 63.45pt;\" /> <col class=\"\" style=\"width: 64.05pt;\" /> <col class=\"\" style=\"width: 70.75pt;\" /> </colgroup><tbody class=\"\"><tr class=\"\"><td>类型</td><td>名称</td><td>id</td><td>url</td><td>备注1</td></tr><tr class=\"\"><td>PK背景</td><td>童趣一夏PK背景</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>半屏座驾</td><td>重返童趣拾光半屏座驾</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>称号</td><td>重返童趣拾光</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>称号</td><td>童心不泯</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>称号</td><td>童趣一夏</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>称号</td><td>童心筑梦</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>称号</td><td>童真的你</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>发言波纹</td><td>童心不泯发言波纹</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>发言波纹</td><td>童心筑梦发言波纹</td><td>4173</td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>公聊皮肤</td><td>童心不泯公聊皮肤</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>观众席底纹</td><td>重返童趣拾光观众席底纹</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>麦序框</td><td>童心不泯麦序框</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>麦序框</td><td>童趣一夏麦序框</td><td>7726</td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>麦序框</td><td>童心筑梦麦序框</td><td>1954</td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>麦序框</td><td>童真的你麦序框</td><td>7725</td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>派对背景</td><td>童趣一夏派对背景</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>热门推荐卡</td><td>热13推荐卡</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>上麦动效</td><td>童心不泯上麦动效</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>送礼托盘</td><td>重返童趣拾光送礼托盘</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>头像框</td><td>重返童趣拾光头像框</td><td><br /></td><td><br /></td><td>新</td></tr><tr class=\"\"><td>头像框</td><td>童心不泯头像框</td><td>2056</td><td><br /></td><td><br /></td>