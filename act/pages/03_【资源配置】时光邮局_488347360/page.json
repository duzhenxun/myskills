    "storage": {
      "value": "<p style=\"\"><span style=\"color: rgb(23,43,77);\">Hi all，</span><br /><span style=\"color: rgb(23,43,77);\">【时光邮局】活动将于2.21日进入测试阶段，现申请相关资源及礼物配置。</span><br /><span style=\"color: rgb(23,43,77);\">辛苦@叶导&nbsp;审批，&nbsp;</span><br /><span style=\"color: rgb(23,43,77);\">辛苦@灿灿配置并返回相关id。</span></p><p style=\"\"><span style=\"color: rgb(23,43,77);\">资源配置</span></p><table><tbody class=\"\"><tr class=\"\"><td>类型</td><td>名称</td><td>id</td><td>url</td><td>备注</td><td><br /></td></tr><tr class=\"\"><td>称号</td><td>街道邮局称号</td><td><br /></td><td><br /></td><td><br /></td><td>3.23-3.26&nbsp; 时光邮局活动获得～</td></tr><tr class=\"\"><td>称号</td><td>海边邮局称号</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>称号</td><td>天空邮局称号</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>称号</td><td>时光邮局称号</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>称号</td><td>时光信笺称号</td><td><br /></td><td><br /></td><td>新</td><td><br /></td></tr><tr class=\"\"><td>称号</td><td>寄语未来称号</td><td><br /></td><td><br /></td><td>新</td><td><br /></td></tr><tr class=\"\"><td>浮屏</td><td>街道邮局浮屏</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>浮屏</td><td>海边邮局浮屏</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>浮屏</td><td>天空邮局浮屏</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>公聊角标</td><td>街道邮局公聊角标</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>公聊角标</td><td>海边邮局公聊角标</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>公聊角标</td><td>天空邮局公聊角标</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>公聊角标</td><td>时光邮局公聊角标</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>公聊皮肤</td><td>时光邮局公聊皮肤</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td>