  "body": {
    "storage": {
      "value": "<p style=\"\"><span style=\"color: rgb(0,0,0);\">Hi all，</span><br /><span style=\"color: rgb(0,0,0);\">【五一放肆嗨】活动将于4.23日进入测试阶段，现申请相关资源及礼物配置。</span><br /><span style=\"color: rgb(0,0,0);\">辛苦@叶导 审批，&nbsp;</span><br /><span style=\"color: rgb(0,0,0);\">辛苦@灿灿配置并返回相关id。<br /></span></p><p style=\"\"><br /></p><p style=\"\"><span style=\"color: rgb(0,0,0);\">具体需求如下：</span><br /><span style=\"color: rgb(0,0,0);\">1、 礼物配置：</span></p><table class=\"relative-table\" style=\"width: 66.0458%;\"><colgroup class=\"\"><col class=\"\" style=\"width: 11.3213%;\" /> <col class=\"\" style=\"width: 13.4872%;\" /> <col class=\"\" style=\"width: 5.7099%;\" /> <col class=\"\" style=\"width: 4.33165%;\" /> <col class=\"\" style=\"width: 8.17106%;\" /> <col class=\"\" style=\"width: 10.7307%;\" /> <col class=\"\" style=\"width: 27.5562%;\" /> <col style=\"width: 18.5079%;\" /></colgroup><tbody class=\"\"><tr class=\"\"><td rowspan=\"17\">礼物墙礼物</td><td>礼物名称</td><td>价格</td><td>id</td><td>url</td><td>备注1</td><td>备注2</td><td>上线时间</td></tr><tr class=\"\"><td>沧海灵珠</td><td>5</td><td><br /></td><td><br /></td><td>新，幸</td><td>（配置同星河玫瑰礼物）</td><td>4.29-5.5</td></tr><tr class=\"\"><td>神晖沐世</td><td>1314</td><td><br /></td><td><br /></td><td>新，幸</td><td>（配置同宠爱时刻礼物）主播获得52映币</td><td>5.3-5.5</td></tr><tr class=\"\"><td>好柿小映</td><td>520</td><td><br /></td><td><br /></td><td>新，幸</td><td><br /></td><td>4.29-5.5</td></tr><tr class=\"\"><td>掘金小映</td><td>2600</td><td><br /></td><td><br /></td><td>幸</td><td><br /></td><td>4.29-5.5</td></tr><tr class=\"\"><td>金枝玉叶</td><td>10</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td><td>4.29-5.5</td></tr><tr class=\"\"><td>金鳞游财</td><td>99</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td><td>5.3-5.5</td></tr><tr class=\"\"><td>缚心之吻</td><td>520</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td><td>4.29-5.5</td></tr><tr class=\"\"><td>鲸跃星空</td><td>999</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td><td>5.3-5.5</td></tr><tr class=\"\"><td>春光共许</td><td>1314</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td><td>5.3-5.5</td></tr><tr class=\"\"><td><br /></td><td>3344</td><td><br /></td><td><br /></td><td>新</td><td><br /></td><td>4.29-5.5</td></tr><tr class=\"\"><td><br /></td><td>5200</td><td><br /></td><td><br /></td><td>新</td><td><br /></td><td>5.3-5.5</td></tr><tr class=\"\"><td>剑影凌霄</td><td>8888</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td><td>4.29-5.5</td></tr><tr class=\"\"><td>鲸云星河</td><td>13140</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td><td>4.29-5.5</td></tr><tr class=\"\"><td>可可喵酱</td><td>21314</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td><td>5.3-5.5</td></tr><tr class=\"\"><td>玫瑰骑士</td><td>52000</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td><td>4.29-5.5</td></tr><tr class=\"\"><td>沧澜绮梦</td><td>99999</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td><td>4.29-5.5</td></tr><tr class=\"\"><td rowspan=\"14\">白名单礼物</td><td>花雨协奏</td><td>13140</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td><td>白名单礼物（配置前沟通）</td></tr><tr class=\"\"><td>星引重逢</td><td>13140</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td><td>白名单礼物（配置前沟通）</td></tr><tr class=\"\"><td>携手相伴</td><td>13140</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td><td>白名单礼物（配置前沟通）</td></tr><tr class=\"\"><td>海屿漫步</td><td>13140</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td><td>白名单礼物（配置前沟通）</td></tr><tr class=\"\"><td>霓虹甜心</td><td>13140</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td><td>白名单礼物（配置前沟通）</td></tr><tr class=\"\"><td>来自雪夜的你</td><td>33440</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td><td>白名单礼物（配置前沟通）</td></tr><tr class=\"\"><td>永恒梦境</td><td>52000</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td><td>白名单礼物（配置前沟通）</td></tr><tr class=\"\"><td>冰河序曲</td><td>52000</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td><td>白名