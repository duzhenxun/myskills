  "body": {
    "storage": {
      "value": "<p style=\"\">Hi all，</p><p style=\"\">【假面舞会】活动将于3.16日进入测试阶段，现申请相关资源配置。</p><p style=\"\">辛苦@叶导 审批，</p><p style=\"\">辛苦@灿灿 配置并返回id。</p><p style=\"\"><br /></p><p style=\"\">具体需求如下：</p><p style=\"\">1、礼物配置：</p><table class=\"relative-table\" style=\"width: 29.6805%;\"><colgroup class=\"\"><col class=\"\" style=\"width: 20.0543%;\" /> <col class=\"\" style=\"width: 25.029%;\" /> <col style=\"width: 9.17212%;\" /><col style=\"width: 5.13017%;\" /><col style=\"width: 5.75201%;\" /><col style=\"width: 9.79396%;\" /><col style=\"width: 25.0187%;\" /></colgroup><tbody class=\"\"><tr class=\"\"><td rowspan=\"14\">礼物墙礼物</td><td>礼物名称</td><td>价格</td><td>id</td><td>url</td><td>备注</td><td>备注</td></tr><tr class=\"\"><td>假面邀约</td><td>10</td><td><br /></td><td><br /></td><td>新，幸</td><td><br /></td></tr><tr class=\"\"><td>花童小映</td><td>1314</td><td><br /></td><td><br /></td><td>幸</td><td>待定，二选一</td></tr><tr class=\"\"><td>炼金小映</td><td>3333</td><td><br /></td><td><br /></td><td>幸</td><td>待定，二选一</td></tr><tr class=\"\"><td>炽焰玫瑰</td><td>21</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>舞动芭蕾</td><td>99</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>缚心之吻</td><td>520</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>星空奇遇</td><td>999</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>春光共许</td><td>1314</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>凤凰之约</td><td>5200</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>王炸甜蜜</td><td>13140</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td></tr><tr class=\"\"><td>求婚大作战</td><td>33440</td><td><br /></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>浪漫约定</td><td>52000</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td></tr><tr class=\"\"><td>时代传奇</td><td>99999</td><td><br /></td><td><br /></td><td>高光</td><td><br /></td></tr></tbody></table><p class=\"auto-cursor-target\"><span style=\"color: rgb(23,43,77);\">2、资源配置需求</span></p><table class=\"relative-table\" style=\"width: 47.2399%;\"><colgroup class=\"\"><col class=\"\" style=\"width: 15.9089%;\" /> <col class=\"\" style=\"width: 16.4945%;\" /> <col class=\"\" style=\"width: 6.44163%;\" /> <col class=\"\" style=\"width: 10.6441%;\" /> <col class=\"\" style=\"width: 29.2801%;\" /> <col class=\"\" style=\"width: 15.8113%;\" /> <col style=\"width: 5.36802%;\" /></colgroup><tbody class=\"\"><tr class=\"\"><td>类型</td><td>名称</td><td>id</td><td>url</td><td>备注1</td><td>备注2</td><td>备注3</td></tr><tr class=\"\"><td>PK背景</td><td>假面舞会PK背景</td><td><br /></td><td><br /></td><td><br /></td><td>主播任务</td><td>新</td></tr><tr class=\"\"><td>称号</td><td>流光捕手</td><td><br /></td><td><br /></td><td>3.19-3.22 假面舞会主播任务获得</td><td>主播任务</td><td>新</td></tr><tr class=\"\"><td>称号</td><td>公爵的舞伴</td><td><br /></td><td><br /></td><td>3.19-3.22 假面舞会用户任务获得</td><td>用户拼图任务</td><td>新</td></tr><tr class=\"\"><td>称号</td><td>假面的邀约</td><td><br /></td><td><br /></td><td>3.19-3.22 假面舞会用户贡献榜单获得</td><td>用户贡献榜</td><td>新</td></tr><tr class=\"\"><td>称号</td><td>宫廷舞者</td><td><br /></td><td><br /></td><td>3.19-3.22 假面舞会主播日榜获得</td><td>主播日榜</td><td>新</td></tr><tr class=\"\"><td>点亮</td><td>假面舞会点亮</td><td>4116</td><td><br /></td><td><br /></td><td>主播任务</td><td><br /></td></tr><tr class=\"\"><td>动态头像框</td><td>公爵的舞伴动态头像框</td><td>9296</td><td><br /></td><td><br /></td><td>用户拼图任务</td><td><br /></td></tr><tr class=\"\"><td>发言波纹</td><td>宫廷舞者发言波纹</td><td>9330</td><td><br /></td><td><br /></td><td>主播日榜</td><td><br /></td></tr><tr class=\"\"><td>公聊皮肤</td><td>公爵的舞伴公聊皮肤</td><td>6863</td><td><br /></td><td><br /></td><td>用户拼图任务</td><td><br /></td></tr><tr class=\"\"><td>公聊皮肤</td><td>假面舞会公聊皮肤</td><td>7188</td><td><br /></td><td><br /></td><td>主播任务</td><td><br /></td></tr><tr class=\"\"><td>观众席底纹</td><td>公爵的舞伴观众席底纹</td><td><br /></td><td><br /></td><td><br /></td><td>用户拼图任务</td><td>新</td></tr><tr class=\"\"><td>进房座驾</td><td>公爵的舞伴座驾</td><td>9472</td><td><br /></td><td><br /></td><td>用户拼图任务</td><td><br /></td></tr><tr class=\"\"><td>麦序框</td><td>假面舞会麦序框</td><td><br /></td><td><br /></td><td><br /></td><td>主播任务</td><td>新</td></tr><tr class=\"\"><td>麦序框</td><td>假面的邀约麦序框</td><td>7179</td><td><br /></td><td><br /></td><td>用户贡献榜</td><td><br /></td></tr><tr class=\"\"><td>麦序框</td><td>宫廷舞者麦序框</td><td>7181</td><td><br /></td><td><br /></td><td>主播日榜</td><td><br /></td></tr><tr class=\"\"><td>派对背景</td><td>假面舞会派对背景</td><td><br /></td><td><br /></td><td>见文件</td><td>主播任务</td><td>新</td></tr><tr class=\"\"><td>热13推荐卡</td><td>热13推荐卡</td><td><br /></td><td><br /></td><td><br /></td><td>主播日榜</td><td><br /></td></tr><tr class=\"\"><td>送礼托盘</td><td>公爵的舞伴送礼托盘</td><td><br /></td><td><br /></td><td><br /></td><td>用户拼图任务</td><td>新</td></tr><tr class=\"\"><td>贴纸</td><td>假面舞会文字贴纸</td><td>1234</td><td><br /></td><td>文字贴纸</td><td>主播任务</td><td><br /></td></tr><tr class=\"\"><td>头像框</td><td>假面舞会头像框</td><td><br /></td><td><br /></td><td><br /></td><td>主播任务</td><td>新</td></tr><tr class=\"\"><td>头像框</td><td>假面的邀约头像框</td><td>7177</td><td><br /></td><td><br /></td><td>用户贡献榜</td><td><br /></td></tr><tr class=\"\"><td>头像框</td><td>宫廷舞者头像框</td><td>6853</td><td><br /></td><td><br /></td><td>主播日榜</td><td><br /></td></tr><tr class=\"\"><td>主页浮屏</td><td>假面舞会主页浮屏</td><td>6857</td><td><br /></td><td><br /></td><td>主播任务</td><td><br /></td></tr><tr class=\"\"><td>主页挂件</td><td>假面舞会主页挂件</td><td>6855</td><td><br /></td><td><br /></td><td>主播任务</td><td><br /></td></tr><tr class=\"\"><td>主页挂件</td><td>宫廷舞者主页挂件</td><td>6856</td><td><br /></td><td><br /></td><td>主播日榜</td><td><br /></td></tr><tr class=\"\"><td>资料卡浮屏</td><td>假面舞会资料卡浮屏</td><td>8695</td><td><br /></td><td><br /></td><td>主播任务</td><td><br /></td></tr><tr class=\"\"><td>资料卡浮屏</td><td>假面的邀约资料卡浮屏</td><td>3307</td><td><br /></td><td><br /></td><td>用户贡献榜</td><td><br /></td></tr></tbody></table><p class=\"auto