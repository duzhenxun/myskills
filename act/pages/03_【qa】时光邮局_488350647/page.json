  "body": {
    "storage": {
      "value": "<h3 style=\"\"><span style=\"color: rgb(0,0,0);\">玩法说明：</span></h3><p style=\"\"><span style=\"color: rgb(0,0,0);\"><strong>主播任务-主播玩法--<span style=\"color: rgb(50,50,50);\">共计三个场景</span></strong></span></p><p style=\"\"><span style=\"color: rgb(0,0,0);\">玩法逻辑：</span></p><p style=\"\"><span style=\"color: rgb(50,50,50);\">活动期间，主播每收礼达21钻则获得1封信件，累计信件数量主播做升级任务拿奖励，共计三个场景</span></p><p style=\"\"><span style=\"color: rgb(50,50,50);\">三个场景，分别为：升级完成之后开启新的场景，且这个场景里送礼达到最高等级之后，剩余的钻石数进入进入场景二</span></p><p style=\"\"><span style=\"color: rgb(50,50,50);\">主播任务三个奖励奖励</span></p><p style=\"\"><span style=\"color: rgb(50,50,50);\">场景一：</span></p><table class=\"relative-table\" style=\"width: 565.0px;\"><colgroup class=\"\"><col class=\"\" style=\"width: 261.0px;\" /><col class=\"\" style=\"width: 310.0px;\" /><col class=\"\" style=\"width: 295.0px;\" /><col class=\"\" style=\"width: 385.0px;\" /></colgroup><tbody class=\"\"><tr class=\"\"><td style=\"text-align: left;\">关卡</td><td style=\"text-align: left;\">任务值</td><td style=\"text-align: left;\">资源类型</td><td style=\"text-align: left;\">资源名称</td></tr><tr class=\"\"><td style=\"text-align: left;\">task_key</td><td style=\"text-align: left;\">score_total</td><td style=\"text-align: left;\">prize_type</td><td style=\"text-align: left;\">prize_name</td></tr><tr class=\"\"><td style=\"text-align: left;\">1</td><td style=\"text-align: left;\">52</td><td style=\"text-align: left;\">头像框</td><td style=\"text-align: left;\">街边邮局头像框</td></tr><tr class=\"\"><td style=\"text-align: left;\">2</td><td style=\"text-align: left;\">199</td><td style=\"text-align: left;\">公聊角标</td><td style=\"text-align: left;\">街边邮局公聊角标</td></tr><tr class=\"\"><td style=\"text-align: left;\">3</td><td style=\"text-align: left;\">239</td><td style=\"text-align: left;\">称号</td><td style=\"text-align: left;\">街边邮局称号</td></tr><tr class=\"\"><td style=\"text-align: left;\">4</td><td style=\"text-align: left;\">399</td><td style=\"text-align: left;\">挂件</td><td style=\"text-align: left;\">街边邮局挂件</td></tr><tr class=\"\"><td style=\"text-align: left;\">5</td><td style=\"text-align: left;\">988</td><td style=\"text-align: left;\">浮屏</td><td style=\"text-align: left;\">街边邮局浮屏</td></tr><tr class=\"\"><td style=\"text-align: left;\">6</td><td style=\"text-align: left;\">999</td><td style=\"text-align: left;\">头像框</td><td style=\"text-align: left;\">海边邮局头像框</td></tr><tr class=\"\"><td style=\"text-align: left;\">7</td><td style=\"text-align: left;\">1099</td><td style=\"text-align: left;\">公聊角标</td><td style=\"text-align: left;\">海边邮局公聊角标</td></tr><tr class=\"\"><td style=\"text-align: left;\">8</td><td style=\"text-align: left;\">1199</td><td style=\"text-align: left;\">称号</td><td style=\"text-align: left;\">海边邮局称号</td></tr><tr class=\"\"><td style=\"text-align: left;\">9</td><td style=\"text-align: left;\">1499</td><td style=\"text-align: left;\">挂件</td><td style=\"text-align: left;\">海边邮局挂件</td></tr><tr class=\"\"><td style=\"text-align: left;\">10</td><td style=\"text-align: left;\">1899</td><td style=\"text-align: left;\">浮屏</td><td style=\"text-align: left;\">海边邮局浮屏</td></tr><tr class=\"\"><td style=\"text-align: left;\">11</td><td style=\"text-align: left;\">1999</td><td style=\"text-align: left;\">头像框</td><td style=\"text-align: left;\">天空邮局头像框</td></tr><tr class=\"\"><td style=\"text-align: left;\">12</td><td style=\"text-align: left;\">2099</td><td style=\"text-align: left;\">公聊角标</td><td style=\"text-align: left;\">天空邮局公聊角标</td></tr><tr class=\"\"><td style=\"text-align: left;\">13</td><td style=\"text-align: left;\">2199</td><td style=\"text-align: left;\">称号</td><td style=\"text-align: left;\">天空邮局称号</td></tr><tr class=\"\"><td style=\"text-align: left;\">14</td><td style=\"text-align: left;\">2399</td><td style=\"text-align: left;\">挂件</td><td style=\"text-align: left;\">天空邮局挂件</td></tr><tr class=\"\"><td style=\"text-align: left;\">15</td><td style=\"text-align: left;\">2899</td><td style=\"text-align: left;\">浮屏</td><td style=\"text-align: left;\">天空邮局浮屏</td></tr></tbody></table><p><br /></p><p class=\"auto-cursor-target\" style=\"\">陪陪奖励</p><table class=\"relative-table\" style=\"width: 576.0px;\"><colgroup class=\"\"><col class=\"\" style=\"width: 156.0px;\" /><col class=\"\" style=\"width: 185.0px;\" /><col class=\"\" style=\"width: 177.0px;\" /><col class=\"\" style=\"width: 206.0px;\" /><col class=\"\" style=\"width: 194.0px;\" /><col class=\"\" style=\"width: 148.0px;\" /></colgroup><tbody class=\"\"><tr class=\"\"><td style=\"text-align: left;\">关卡</td><td style=\"text-align: left;\">任务值</td><td style=\"text-align: left;\">资源类型</td><td style=\"text-align: left;\">资源名称</td><td style=\"text-align: left;\">资源id</td><td style=\"text-align: left;\">时长</td></tr><tr class=\"\"><td style=\"text-align: left;\">task_key</td><td style=\"text-align: left;\">score_total</td><td style=\"text-align: left;\">prize_type</td><td style=\"text-align: left;\">prize_name</td><td style=\"text-align: left;\">resource_id</td><td style=\"text-align: left;\">duration</td></tr><tr class=\"\"><td style=\"text-align: left;\">1</td><td style=\"text-align: left;\">52</td><td style=\"text-align: left;\">麦序框</td><td style=\"text-align: left;\">街边邮局麦序框</td><td style=\"text-align: left;\">9935</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">2</td><td style=\"text-align: left;\">199</td><td style=\"text-align: left;\">公聊角标</td><td style=\"text-align: left;\">街边邮局公聊角标</td><td style=\"text-align: left;\">9929</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">3</td><td style=\"text-align: left;\">239</td><td style=\"text-align: left;\">称号</td><td style=\"text-align: left;\">街边邮局称号</td><td style=\"text-align: left;\">2219</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">4</td><td style=\"text-align: left;\">399</td><td style=\"text-align: left;\">挂件</td><td style=\"text-align: left;\">街边邮局挂件</td><td style=\"text-align: left;\">9947</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">5</td><td style=\"text-align: left;\">988</td><td style=\"text-align: left;\">浮屏</td><td style=\"text-align: left;\">街边邮局浮屏</td><td style=\"text-align: left;\">9946</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">6</td><td style=\"text-align: left;\">999</td><td style=\"text-align: left;\">麦序框</td><td style=\"text-align: left;\">海边邮局麦序框</td><td style=\"text-align: left;\">9936</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">7</td><td style=\"text-align: left;\">1099</td><td style=\"text-align: left;\">公聊角标</td><td style=\"text-align: left;\">海边邮局公聊角标</td><td style=\"text-align: left;\">9930</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">8</td><td style=\"text-align: left;\">1199</td><td style=\"text-align: left;\">称号</td><td style=\"text-align: left;\">海边邮局称号</td><td style=\"text-align: left;\">2220</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">9</td><td style=\"text-align: left;\">1499</td><td style=\"text-align: left;\">挂件</td><td style=\"text-align: left;\">海边邮局挂件</td><td style=\"text-align: left;\">9949</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">10</td><td style=\"text-align: left;\">1899</td><td style=\"text-align: left;\">浮屏</td><td style=\"text-align: left;\">海边邮局浮屏</td><td style=\"text-align: left;\">9948</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">11</td><td style=\"text-align: left;\">1999</td><td style=\"text-align: left;\">麦序框</td><td style=\"text-align: left;\">天空邮局麦序框</td><td style=\"text-align: left;\">9937</td><td style=\"text-align: left;\">5</td></tr><tr class=\"\"><td style=\"text-align: left;\">12</td><td style=