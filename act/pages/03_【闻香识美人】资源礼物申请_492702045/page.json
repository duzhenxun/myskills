  "body": {
    "storage": {
      "value": "<p style=\"\">Hi all，</p><p style=\"\">【闻香识美人】活动将于4.1日进入测试阶段，现申请相关资源配置。</p><p style=\"\">辛苦@叶导 审批，</p><p style=\"\">辛苦@灿灿 配置并返回id。</p><p style=\"\"><br /></p><p style=\"\">具体需求如下：</p><p style=\"\">1、礼物配置：</p><table class=\"relative-table\" style=\"width: 34.7594%;\"><colgroup class=\"\"><col class=\"\" style=\"width: 22.2109%;\" /> <col class=\"\" style=\"width: 23.826%;\" /> <col style=\"width: 8.73627%;\" /><col style=\"width: 4.73832%;\" /><col style=\"width: 5.47868%;\" /><col style=\"width: 8.29205%;\" /><col style=\"width: 26.653%;\" /></colgroup><tbody class=\"\"><tr class=\"\"><td rowspan=\"17\">礼物墙礼物</td><td>礼物名称</td><td>价格</td><td>id</td><td>url</td><td>备注1</td><td>上线时间</td></tr><tr class=\"\"><td>制造浪漫</td><td>10</td><td><br /></td><td><br /></td><td><br /></td><td>7号-10号</td></tr><tr class=\"\"><td>奢心之翼</td><td>52</td><td><br /></td><td><br /></td><td><br /></td><td>9号-10号</td></tr><tr class=\"\"><td>鲸落星海</td><td>99</td><td><br /></td><td><br /></td><td><br /></td><td>7号-10号</td></tr><tr class=\"\"><td>雨幕倾心</td><td>520</td><td><br /></td><td><br /></td><td><br /></td><td>7号-10号</td></tr><tr class=\"\"><td>甜蜜漫刊亭</td><td>999</td><td><br /></td><td><br /></td><td><br /></td><td>9号-10号</td></tr><tr class=\"\"><td>时光恋人</td><td>1314</td><td><br /></td><td><br /></td><td><br /></td><td>7号-10号</td></tr><tr class=\"\"><td>人鱼泪光</td><td>3344</td><td><br /></td><td><br /></td><td><br /></td><td>9号-10号</td></tr><tr class=\"\"><td>灯影翩鸿</td><td>5200</td><td><br /></td><td><br /></td><td><br /></td><td>7号-10号</td></tr><tr class=\"\"><td>一骑破苍穹</td><td>6666</td><td><br /></td><td><br /></td><td><br /></td><td>9号-10号</td></tr><tr class=\"\"><td>夜明珠</td><td>7777</td><td><br /></td><td><br /></td><td><br /></td><td>9号-10号</td></tr><tr class=\"\"><td>月下独角兽</td><td>8888</td><td><br /></td><td><br /></td><td><br /></td><td>7号-10号</td></tr><tr class=\"\"><td>游弋惊鸿</td><td>10000</td><td><br /></td><td><br /></td><td>高光</td><td>9号-10号</td></tr><tr class=\"\"><td>公主的骑士</td><td>13140</td><td><br /></td><td><br /></td><td>高光</td><td>9号-10号</td></tr><tr class=\"\"><td>烛影时光</td><td>33440</td><td><br /></td><td><br /></td><td>高光</td><td>7号-10号</td></tr><tr class=\"\"><td>永恒梦境</td><td>52000</td><td><br /></td><td><br /></td><td>高光</td><td>9号-10号</td></tr><tr class=\"\"><td>爱情海</td><td>99999</td><td><br /></td><td><br /></td><td>高光</td><td>7号-10号</td></tr></tbody></table><p class=\"auto-cursor-target\"><span style=\"color: rgb(23,43,77);\">2、资源配置需求</span></p><table><colgroup class=\"\"><col class=\"\" style=\"width: 122.0pt;\" /> <col class=\"\" style=\"width: 174.0pt;\" /> <col class=\"\" style=\"width: 49.5pt;\" /> <col class=\"\" style=\"width: 189.0pt;\" /> <col class=\"\" style=\"width: 82.5pt;\" /> </colgroup><tbody class=\"\"><tr class=\"\"><td>类型</td><td>名称</td><td>id</td><td>url</td><td>备注1</td><td><br /></td><td>备注2</td></tr><tr class=\"\"><td>PK背景</td><td>闻香识美人PK背景</td><td><br /></td><td><br /></td><td>新</td><td><br /></td><td>主播任务</td></tr><tr class=\"\"><td>称号</td><td>闻香旅人</td><td><br /></td><td><br /></td><td>新</td><td><br /></td><td>用户日榜</td></tr><tr class=\"\"><td>称号</td><td>摩登香影</td><td><br /></td><td><br /></td><td>新</td><td><br /></td><td>用户日任务</td></tr><tr class=\"\"><td>称号</td><td>黑胶名伶称号</td><td><br /></td><td><br /></td><td>新</td><td><br /></td><td>主播任务</td></tr><tr class=\"\"><td>称号</td><td>闻香识美人</td><td><br /></td><td><br /></td><td>新</td><td><br /></td><td>主播日榜</td></tr><tr class=\"\"><td>发言波纹</td><td>闻香识美人发言波纹</td><td>5759</td><td><br /></td><td>改名</td><td><br /></td><td>主播日榜</td></tr><tr class=\"\"><td>发言波纹</td><td>摩登香影发言波纹</td><td><br /></td><td><br /></td><td>新</td><td><br /></td><td>用户日任务</td></tr><tr class=\"\"><td>公聊角标</td><td>黑胶名伶公聊角标</td><td><br /></td><td><br /></td><td>新</td><td><br /></td><td>主播任务（嘉宾）</td></tr><tr class=\"\"><td>公聊皮肤</td><td>黑胶名伶公聊皮肤</td><td><br /></td><td><br /></td><td>新</td><td><br /></td><td>主播任务</td></tr><tr class=\"\"><td>公聊皮肤</td><td>绯闻缪斯公聊皮肤</td><td>9445</td><td><br /></td><