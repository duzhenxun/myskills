    "storage": {
      "value": "<p class=\"ne-p\" style=\"text-align: justify;\"><span style=\"color: rgb(23,43,77);\">Hi all，</span><br /><span style=\"color: rgb(23,43,77);\">【林海雪踪​】活动将于1.4日进入测试阶段，现申请相关资源及礼物配置。</span><br /><span style=\"color: rgb(23,43,77);\">辛苦@叶导&nbsp;审批，&nbsp;</span><br /><span style=\"color: rgb(23,43,77);\">辛苦@灿灿配置并返回相关id。</span></p><p class=\"ne-p\" style=\"text-align: justify;\">1.礼物配置</p><table class=\"relative-table wrapped\" style=\"width: 687.0px;\"><colgroup><col style=\"width: 98.0px;\" /><col style=\"width: 87.0px;\" /><col style=\"width: 70.0px;\" /><col style=\"width: 431.0px;\" /></colgroup><tbody class=\"\"><tr class=\"\"><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">礼物名称</span></p></td><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">礼物价格</span></p></td><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">礼物ID</span></p></td><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">url</span></p></td></tr><tr class=\"\"><td style=\"text-align: left;\">掘金小映</td><td style=\"text-align: left;\">2666</td><td style=\"text-align: left;\"><br /></td><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\"><a class=\"external-link\" style=\"text-align: center;\" href=\"https://img.ikstatic.cn/MTY1MDk1Nzc3MDA4NCM5MDcjcG5n.png\" rel=\"nofollow\">https://img.ikstatic.cn/MTY1MDk1Nzc3MDA4NCM5MDcjcG5n.png</a></span></p></td></tr><tr class=\"\"><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">冰淇淋车</span></p></td><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">12</span></p></td><td style=\"text-align: left;\"><br /></td><td style=\"text-align: left;\"><p class=\"ne-p\"><a href=\"https://img.ikstatic.cn/MTY1OTQxOTg0MjA4OSMzMDAjcG5n.png\" class=\"external-link\" rel=\"nofollow\"><span class=\"ne-text\">https://img.ikstatic.cn/MTY1OTQxOTg0MjA4OSMzMDAjcG5n.png</span></a></p></td></tr><tr class=\"\"><td style=\"text-align: left;\">心动丘比特</td><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">99</span></p></td><td style=\"text-align: left;\"><br /></td><td style=\"text-align: left;\"><a class=\"external-link\" href=\"https://img.ikstatic.cn/MTczOTE4MTEzNTE5MyMzODYjcG5n.png\" rel=\"nofollow\">https://img.ikstatic.cn/MTczOTE4MTEzNTE5MyMzODYjcG5n.png</a></td></tr><tr class=\"\"><td style=\"text-align: left;\"><p class=\"ne-p\">冰城玫瑰</p></td><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">520</span></p></td><td style=\"text-align: left;\"><br /></td><td style=\"text-align: left;\"><a class=\"external-link\" href=\"https://img.ikstatic.cn/MTczMTMwNjY2MTQ5OCMyOTkjcG5n.png\" rel=\"nofollow\">https://img.ikstatic.cn/MTczMTMwNjY2MTQ5OCMyOTkjcG5n.png</a></td></tr><tr class=\"\"><td style=\"text-align: left;\">圣诞礼盒</td><td style=\"text-align: left;\">3333</td><td style=\"text-align: left;\">23718</td><td style=\"text-align: left;\"><a href=\"https://img.ikstatic.cn/MTYzOTk4ODA5MTk1MCMyNzkjcG5n.png\" class=\"external-link\" rel=\"nofollow\">https://img.ikstatic.cn/MTYzOTk4ODA5MTk1MCMyNzkjcG5n.png</a></td></tr><tr class=\"\"><td style=\"text-align: left;\"><p class=\"ne-p\">月起相思</p></td><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">8888</span></p></td><td style=\"text-align: left;\"><br /></td><td style=\"text-align: left;\"><a href=\"https://img.ikstatic.cn/MTY5NTYyOTA1NDkyMSM1MDMjcG5n.png\" class=\"external-link\" rel=\"nofollow\">https://img.ikstatic.cn/MTY5NTYyOTA1NDkyMSM1MDMjcG5n.png</a></td></tr><tr class=\"\"><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">成为天下万人迷</span></p></td><td style=\"text-align: left;\"><p class=\"ne-p\"><span class=\"ne-text\">23333</span></p></td><td style=\"text-align: left;\"><br /></td><td style=\"text-align: left;\"><a href=\"https://img.ikstatic.cn/MTYzNjM2NTMzOTk1NCM2NzUjcG5n.png\" class=\"external-link\" rel=\"nofollow\">https://img.ikstatic.cn/