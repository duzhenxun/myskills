  "body": {
    "storage": {
      "value": "<p style=\"\"><span style=\"color: rgb(0,0,0);\">Hi all，</span><br /><span style=\"color: rgb(0,0,0);\">【福马迎春送财运】活动将于2.9日进入测试阶段，现申请相关资源及礼物配置。</span><br /><span style=\"color: rgb(0,0,0);\">辛苦@叶导 审批，&nbsp;</span><br /><span style=\"color: rgb(0,0,0);\">辛苦@灿灿配置并返回相关id。<br /></span></p><p style=\"\"><br /></p><p style=\"\"><span style=\"color: rgb(0,0,0);\">具体需求如下：</span><br /><span style=\"color: rgb(0,0,0);\">1、 资源配置：</span></p><table><colgroup class=\"\"><col class=\"\" style=\"width: 85.0pt;\" /> <col class=\"\" style=\"width: 128.5pt;\" /> <col class=\"\" style=\"width: 49.5pt;\" /> <col class=\"\" style=\"width: 256.5pt;\" /> </colgroup><tbody class=\"\"><tr class=\"\"><td>资源</td><td>名称</td><td>id</td><td>url</td><td>备注</td></tr><tr class=\"\"><td>动态头像框</td><td>马跃福至动态头像框</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>动态麦序框</td><td>马跃福至动态麦序框</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>上麦特效</td><td>马跃福至上麦特效</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>发言波纹</td><td>马跃福至发言波纹</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>贴纸</td><td>马跃福至贴纸</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>资料卡浮屏</td><td>马跃福至资料卡浮屏</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>主页挂件</td><td>马跃福至主页挂件</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>主页浮屏</td><td>马跃福至主页浮屏</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>称号</td><td>前程骅骅称号</td><td><br /></td><td><br /></td><td>2.16-3.3 春节开播红包累计打卡任务获得</td></tr><tr class=\"\"><td>称号</td><td>马上发财<span class=\"font6\">称号</span></td><td><br /></td><td><br /></td><td>2.16-3.3 春节马上发财累计打卡任务获得</td></tr><tr class=\"\"><td>麦序框</td><td>财路骏骏<span class=\"font7\">麦序框</span></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>资料卡浮屏</td><td>财路骏骏<span class=\"font6\">资料卡浮屏</span></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>勋章</td><td>财路骏骏<span class=\"font6\">勋章</span></td><td><br /></td><td><br /></td><td>主播侧，独一型</td></tr><tr class=\"\"><td>主页挂件</td><td>财路骏骏主页挂件</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>麦序框</td><td>神驹纳喜<span class=\"font2\">麦序框</span></td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>背景</td><td>福马迎春派对背景</td><td><br /></td><td><br /></td><td><br /></td></tr><tr class=\"\"><td>背景</td><td>福马迎春PK背景</td><td><br /></td><td><br /></td><td><br /></td></tr></tbody></table><p style=\"\"><span style=\"color: rgb(0,0,0);\"><span style=\"color: rgb(23,43,77);\">以上，如有问题及时沟通～</span></span></p>",
