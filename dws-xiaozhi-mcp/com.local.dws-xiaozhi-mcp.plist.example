<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS 开机自启示例。
  1. 把下面 YOUR_USERNAME 换成你的用户名（把 <string>/Users/YOUR_USERNAME/...</string> 全部改掉）
  2. 复制到 ~/Library/LaunchAgents/com.local.dws-xiaozhi-mcp.plist
  3. 执行：
       launchctl unload ~/Library/LaunchAgents/com.local.dws-xiaozhi-mcp.plist 2>/dev/null || true
       launchctl load  ~/Library/LaunchAgents/com.local.dws-xiaozhi-mcp.plist
  4. 查看状态：launchctl list | grep dws-xiaozhi
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.dws-xiaozhi-mcp</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/data/ai/work/dws-xiaozhi-mcp/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/data/ai/work/dws-xiaozhi-mcp</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/data/ai/work/dws-xiaozhi-mcp/.dws-mcp.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/data/ai/work/dws-xiaozhi-mcp/.dws-mcp.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/YOUR_USERNAME/.nvm/versions/node/v22.22.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
