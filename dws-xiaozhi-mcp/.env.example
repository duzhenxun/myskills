# 小智 AI MCP 接入点地址（在 xiaozhi.me 控制台 -> 智能体 -> 配置角色 页面右下角获取）
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=请替换成你自己的_token

# 可选：单次 dws 调用超时（秒）。小智服务端 tool call 约 10s 超时，建议 <= 9
#DWS_TOOL_TIMEOUT=9
# 可选：传给 dws 的 HTTP 超时（秒）
#DWS_HTTP_TIMEOUT=8
# 可选：返回给大模型的最大字符数
#DWS_MAX_CHARS=6000
# 可选：多组织时指定 profile（dws profile list 里的 corpId:userId）
#DWS_PROFILE=
# 可选：指定 dws 可执行文件路径
#DWS_BIN=/Users/you/.nvm/versions/node/v22.22.0/bin/dws
# 可选：覆盖本地 MCP server 启动命令
#DWS_MCP_CMD=uv run --python 3.12 server.py
