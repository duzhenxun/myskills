{
  "name": "codex-deepseek-setup",
  "version": "1.0.1",
  "description": "把 Codex CLI 接到 DeepSeek 网关：本地适配器 + launchd/systemd 常驻服务 + 实时请求/回复网页，一条命令安装，一条命令还原。",
  "bin": {
    "codex-deepseek-setup": "bin/cli.mjs",
    "codex-deepseek": "bin/cli.mjs"
  },
